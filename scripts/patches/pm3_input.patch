@@ -89,10 +89,45 @@ int kbd_enter_pressed(void) {
 #else

 #include <conio.h>
+#include <fcntl.h>
+#include <io.h>
+
 int kbd_enter_pressed(void) {
     int ret = 0;
-    while (kbhit()) {
-        ret |= getch() == '\r';
+
+    // Interactive console builds keep the original behaviour.
+    if (_isatty(_fileno(stdin))) {
+        while (_kbhit()) {
+            ret |= _getch() == '\r';
+        }
+        return ret;
+    }
+
+    // GUI builds receive input through the bridge's stdin pipe instead of a
+    // console. Peek first so the command loop never blocks on an empty pipe.
+    int fd = _fileno(stdin);
+    HANDLE handle = (HANDLE)_get_osfhandle(fd);
+    if (handle == INVALID_HANDLE_VALUE) {
+        return 0;
+    }
+
+    DWORD available = 0;
+    if (!PeekNamedPipe(handle, NULL, 0, NULL, &available, NULL)) {
+        return 0;
+    }
+
+    while (available > 0) {
+        char buffer[128];
+        DWORD read_len = 0;
+        if (!ReadFile(handle, buffer, sizeof(buffer), &read_len, NULL) || read_len == 0) {
+            break;
+        }
+        for (DWORD i = 0; i < read_len; i++) {
+            if (buffer[i] == '\n') {
+                ret = 1;
+            }
+        }
+        available = available > read_len ? available - read_len : 0;
     }
     return ret;
 }
